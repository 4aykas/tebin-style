{
  "color": {
    "brand":   { "$type": "color", "$value": "#2563EB" },
    "ink":     { "$type": "color", "$value": "#0F172A" },
    "muted":   { "$type": "color", "$value": "#64748B" },
    "topbar":  { "$type": "color", "$value": "#F8FAFC" },
    "surface": { "$type": "color", "$value": "#FFFFFF" },
    "error":   { "$type": "color", "$value": "#C7251A", "$description": "Error text. 5.66:1 on #FFFFFF." },
    "warning": { "$type": "color", "$value": "#8A5300", "$description": "Warning text. 6.33:1 on #FFFFFF." },
    "success": { "$type": "color", "$value": "#1F6F43", "$description": "Success text. 6.15:1 on #FFFFFF." },
    "rule":    { "$type": "color", "$value": "#E2E8F0" }
  },
  "role": {
    "primary":          { "$type": "color", "$value": "{color.brand}", "$description": "Accent. Fills, borders and large text." },
    "surface":          { "$type": "color", "$value": "{color.surface}", "$description": "The base page surface." },
    "on-surface":       { "$type": "color", "$value": "{color.ink}", "$description": "Primary text on the base surface." },
    "on-surface-muted": { "$type": "color", "$value": "{color.muted}", "$description": "Secondary text on the base surface." },
    "outline":          { "$type": "color", "$value": "{color.rule}", "$description": "Hairlines and dividers." },
    "error":            { "$type": "color", "$value": "{color.error}", "$description": "Error text." },
    "warning":          { "$type": "color", "$value": "{color.warning}", "$description": "Warning text." },
    "success":          { "$type": "color", "$value": "{color.success}", "$description": "Success text." }
  },
  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" }
  }
}
